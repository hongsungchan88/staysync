# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 저장소에 커밋하지 않는다.

# --- LLM (P4 에서 사용) ---
OPENAI_API_KEY=sk-...

# --- 채널 자격증명 암호화 키 (32바이트 Base64) ---
STAYSYNC_CREDENTIAL_KEY=

# --- docker 프로파일용 ---
POSTGRES_USER=staysync
POSTGRES_PASSWORD=staysync
POSTGRES_DB=staysync

# --- 공공데이터포털 특일 정보 (P4 요금 추천에서 사용) ---
DATA_GO_KR_SERVICE_KEY=
