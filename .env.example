# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 저장소에 커밋하지 않는다.

# --- LLM (P4 에서 사용) ---
OPENAI_API_KEY=sk-...

# --- JWT 서명 키 (HS256, 최소 32바이트) ---
# 값이 없으면 애플리케이션이 기동되지 않는다. local 프로파일은 개발용 고정값이
# application-local.yml 에 박혀 있어 이 항목 없이도 뜬다.
#
# 이 키가 바뀌면 이미 발급된 액세스 토큰이 전부 무효가 되어 모든 사용자가 다시
# 로그인해야 한다. 재기동한다고 바뀌지 않도록 고정된 값을 넣는다.
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# --- 게스트 연락처 암호화 키 (AES-256-GCM, 32바이트 Base64) ---
# 값이 없으면 애플리케이션이 기동되지 않는다. local 프로파일은 개발용 고정값이
# application-local.yml 에 박혀 있어 이 항목 없이도 뜬다.
#
# 이 키가 바뀌면 이미 저장된 게스트 연락처를 복호화할 수 없고 검색 해시도 달라져
# 기존 행을 찾지 못한다. 키 교체에는 재암호화 마이그레이션이 따른다.
# 생성 예: openssl rand -base64 32
GUEST_DATA_KEY=

# --- 채널 연동 (P3) ---
# 개발용 기본값이다. 코드가 이 값을 직접 읽지 않는다 — 제품의 모양은 호스트가 화면에서
# 자기 키를 넣는 것이고, 저장할 때 GUEST_DATA_KEY 로 암호화한다(ADR 0007).
# 로컬에서 채널 연결을 만들어 볼 때 손으로 복사해 쓰는 값이다.
#
# AIRBNB_ICAL_URL 은 에어비앤비 달력 내보내기 주소다. 주소를 아는 사람은 누구나 예약
# 일정을 읽으므로 API 키와 같이 취급한다. 저장소에 넣지 않는다.
CHANNEX_API_KEY=
CHANNEX_BASE_URL=https://staging.channex.io
AIRBNB_ICAL_URL=

# --- docker 프로파일용 ---
POSTGRES_USER=staysync
POSTGRES_PASSWORD=staysync
POSTGRES_DB=staysync

# --- 포트원 V2 테스트 결제 (P4 16주차, 직접예약 위젯) ---
# 콘솔의 결제 연동 → 연동 관리에서 얻는다. 연동 모드는 테스트다.
# KG이니시스로 채널을 만들 때 PG상점아이디는 공용 MID INIpayTest 를 고르면
# signkey 와 INIAPI Key 가 자동으로 채워진다.
#
# 앞의 둘과 뒤의 둘은 취급이 다르다.
#   STORE_ID, CHANNEL_KEY  — 브라우저의 결제창 SDK 로 나가는 값이다. 비밀이 아니다
#   API_SECRET, WEBHOOK_SECRET — 서버 밖으로 절대 나가지 않는다.
#                                프론트 번들이나 응답 본문에 실리면 안 된다
#
# API_SECRET 은 발급 직후에만 보인다. 창을 닫으면 다시 못 보고 재발급해야 한다.
# WEBHOOK_SECRET 은 결제알림(Webhook) 관리에서 따로 발급한다. 웹훅 URL 은 공개
# 터널 주소가 필요하므로 위젯이 뜬 뒤에 등록해도 된다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# --- 공공데이터포털 특일 정보 (P4 요금 추천에서 사용) ---
DATA_GO_KR_SERVICE_KEY=
