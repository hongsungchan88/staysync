# 서버의 /opt/staysync/.env 로 복사해 채운다. 권한은 600, 저장소에 넣지 않는다.
# 로컬 프로파일의 고정 키를 여기 넣지 않는다 — 공개되어 있다는 전제의 값이다.

# Caddy 가 인증서를 받을 도메인. DNS 의 A 레코드가 이 서버의 고정 IP 를 가리켜야 한다.
SITE_ADDRESS=staysync.example.com
# 앱이 iCal 발행 URL 을 만들 때 쓰는 공개 주소. 위와 같은 도메인, https.
PUBLIC_BASE_URL=https://staysync.example.com

# PostgreSQL. 컨테이너 안에서만 쓰이고 밖으로 열리지 않는다.
POSTGRES_USER=staysync
POSTGRES_PASSWORD=
POSTGRES_DB=staysync

# 처음 한 번 정하고 바꾸지 않는다. GUEST_DATA_KEY 를 바꾸면 기존 암호문을 못 읽는다.
# 생성: openssl rand -base64 48 / openssl rand -base64 32
JWT_SECRET=
GUEST_DATA_KEY=

# 포트원 테스트 결제. 웹훅 URL 은 https://<SITE_ADDRESS>/public/payments/portone/webhook
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
